@using Microsoft.AspNetCore.Http
@{
    string ActiveClass(string page)
    {
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
        // exact match or subpath match (for when we have deeper structures, though here mostly flat)
        return string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "active fw-bold border-bottom border-primary" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BulkMailSender</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BulkMailSender.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="bi bi-envelope-paper-fill text-primary"></i> BulkMailSender
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark @ActiveClass("/Index")" asp-area="" asp-page="/Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        
                        <!-- Workflow Divider -->
                        <li class="nav-item d-none d-lg-block mx-2">
                            <span class="text-muted">|</span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark @ActiveClass("/Recipients")" asp-area="" asp-page="/Recipients">
                                <span class="badge rounded-pill bg-light text-dark border">1</span> Recipients
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @ActiveClass("/Upload")" asp-area="" asp-page="/Upload">
                                <span class="badge rounded-pill bg-light text-dark border">2</span> Upload
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @ActiveClass("/Template")" asp-area="" asp-page="/Template">
                                <span class="badge rounded-pill bg-light text-dark border">3</span> Draft
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @ActiveClass("/Preview")" asp-area="" asp-page="/Preview">
                                <span class="badge rounded-pill bg-light text-dark border">4</span> Preview
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @ActiveClass("/SendResults")" asp-area="" asp-page="/SendResults">
                                <span class="badge rounded-pill bg-light text-dark border">5</span> Results
                            </a>
                        </li>

                         <!-- Settings Divider -->
                        <li class="nav-item d-none d-lg-block mx-2">
                            <span class="text-muted">|</span>
                        </li>

                        <li class="nav-item ms-auto">
                            <a class="nav-link text-dark @ActiveClass("/Settings")" asp-area="" asp-page="/Settings">
                                <i class="bi bi-gear"></i> Settings
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BulkMailSender - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
