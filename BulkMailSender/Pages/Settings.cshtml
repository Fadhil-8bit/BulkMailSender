@page
@model BulkMailSender.Pages.SettingsModel
@{
    ViewData["Title"] = "System Configuration";
}

<div class="container-fluid py-4">
    
    <!-- Status Messages -->
    @if (Model.HasSavedSettings)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> Settings saved successfully!
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.TestResult))
    {
        <div class="alert @(Model.TestSuccess ? "alert-success" : "alert-danger") shadow-sm mb-4 alert-dismissible fade show" role="alert">
            <i class="bi @(Model.TestSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i> @Model.TestResult
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Profile Management Section -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
             <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-primary mb-0"><i class="bi bi-person-workspace me-2"></i>Profile Management</h5>
                <span class="badge bg-light text-dark border">Active: <strong>@Model.ActiveProfile</strong></span>
            </div>
             <div class="row g-3">
                 <!-- Profile Switcher -->
                 <div class="col-md-6">
                     <form method="post" asp-page-handler="SwitchProfile" class="d-flex gap-2 align-items-end">
                         <div class="flex-grow-1">
                            <label class="form-label text-muted small fw-bold">Switch Profile</label>
                            <select class="form-select" name="selectedProfile" onchange="this.form.submit()">
                                @foreach(var p in Model.AvailableProfiles) {
                                    <option value="@p" selected="@(p == Model.ActiveProfile)">@p</option>
                                }
                            </select>
                         </div>
                         <button type="submit" asp-page-handler="DeleteProfile" class="btn btn-danger" 
                                 onclick="return confirm('Are you sure you want to PERMANENTLY DELETE the selected profile?');"
                                 title="Delete Selected Profile">
                             <i class="bi bi-trash"></i>
                         </button>
                    </form>
                 </div>

                 <!-- Save New Profile -->
                 <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Create New Profile</label>
                    <div class="input-group">
                        <input type="text" class="form-control" form="settingsForm" asp-for="NewProfileName" placeholder="New Profile Name" />
                        <button type="submit" form="settingsForm" asp-page-handler="SaveProfile" class="btn btn-success">
                            <i class="bi bi-plus-lg me-2"></i> Save Profile
                        </button>
                    </div>
                 </div>
             </div>
        </div>
    </div>

    <form method="post" id="settingsForm">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pb-0 pt-4 px-4">
                 <!-- Tabs Navigation -->
                <ul class="nav nav-tabs card-header-tabs" id="settingTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold" id="smtp-tab" data-bs-toggle="tab" data-bs-target="#smtp" type="button" role="tab" aria-selected="true">
                            <i class="bi bi-hdd-network me-2"></i> SMTP Configuration
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold" id="presets-tab" data-bs-toggle="tab" data-bs-target="#presets" type="button" role="tab" aria-selected="false">
                            <i class="bi bi-stars me-2"></i> Preset Actions
                        </button>
                    </li>
                </ul>
            </div>
           
            <div class="card-body p-4 bg-white rounded-bottom">
                 <div class="tab-content" id="settingTabsContent">
                    
                    <!-- TAB 1: SMTP CONFIGURATION -->
                    <div class="tab-pane fade show active" id="smtp" role="tabpanel">
                        
                        <!-- SECTION: IDENTITY -->
                        <div class="mb-5">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h4 class="text-primary mb-0">Identity Configuration</h4>
                                <span class="badge bg-secondary">Required</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small text-uppercase fw-bold">From Email Address</label>
                                    <input type="email" class="form-control" asp-for="CurrentSettings.FromEmail" placeholder="ops@domain.com" />
                                    <div class="form-text">The origin address shown to recipients.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small text-uppercase fw-bold">Display Name</label>
                                    <input type="text" class="form-control" asp-for="CurrentSettings.FromName" placeholder="System Administrator" />
                                    <div class="form-text">The friendly name displayed in mail clients.</div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION: CONNECTION -->
                        <div class="mb-5">
                             <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h4 class="text-primary mb-0">Server Connection</h4>
                                <span class="badge bg-info text-dark">SMTP</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label text-muted small text-uppercase fw-bold">Host Address</label>
                                    <input type="text" class="form-control" asp-for="CurrentSettings.Host" placeholder="smtp.provider.net" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small text-uppercase fw-bold">Port</label>
                                    <input type="number" class="form-control" asp-for="CurrentSettings.Port" placeholder="587" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label text-muted small text-uppercase fw-bold">Username</label>
                                    <input type="text" class="form-control" asp-for="CurrentSettings.Username" autocomplete="off" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small text-uppercase fw-bold">Password / Key</label>
                                    <input type="password" class="form-control" asp-for="CurrentSettings.Password" autocomplete="off" value="@Model.CurrentSettings.Password" />
                                </div>

                                <div class="col-12 mt-3">
                                    <div class="card bg-light border-0">
                                        <div class="card-body d-flex align-items-center justify-content-between py-2">
                                            <div>
                                                <div class="fw-bold text-dark mb-0">Enable SSL/TLS Encryption</div>
                                                <div class="small text-muted">Secure connection layer for data protection</div>
                                            </div>
                                            <div class="form-check form-switch cursor-pointer">
                                                <input class="form-check-input" type="checkbox" asp-for="CurrentSettings.EnableSsl" style="transform: scale(1.3); cursor: pointer;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION: ADVANCED -->
                        <div>
                             <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h4 class="text-primary mb-0">Advanced Parameters</h4>
                                <span class="badge bg-warning text-dark">Optional</span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small text-uppercase fw-bold">Global CC (Surveillance)</label>
                                <textarea class="form-control" asp-for="CurrentSettings.GlobalCc" rows="2" placeholder="audit@corp.com; boss@corp.com"></textarea>
                                <div class="form-text">Semicolon-separated list. Copies all traffic to these addresses.</div>
                            </div>

                            <div class="mb-3 w-50">
                                <label class="form-label text-muted small text-uppercase fw-bold">Connection Timeout (Seconds)</label>
                                <input type="number" class="form-control" asp-for="CurrentSettings.TimeoutSeconds" />
                            </div>
                            
                            @if (Model.HasSavedSettings)
                            {
                                <div class="mt-5 pt-4 border-top">
                                    <h5 class="text-danger text-uppercase mb-3">Danger Zone</h5>
                                    <button type="submit" asp-page-handler="ClearSettings" class="btn btn-outline-danger"
                                            onclick="return confirm('WARNING: Are you sure you want to FACTORY RESET? This will delete your current configuration and revert to default settings. This action cannot be undone.');">
                                        <i class="bi bi-trash me-2"></i> Factory Reset
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- TAB 2: PRESET ACTIONS -->
                    <div class="tab-pane fade" id="presets" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
                            <h4 class="text-primary mb-0">Quick Load Profiles</h4>
                            <span class="badge bg-primary">Templates</span>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card h-100 border-primary shadow-sm bg-light">
                                    <div class="card-body text-center p-4">
                                        <div class="display-4 text-primary mb-3"><i class="bi bi-cloud-lightning-fill"></i></div>
                                        <h4 class="text-uppercase fw-bold text-dark">Production</h4>
                                        <p class="text-muted small">Brevo Relay Configuration<br>Port 587 | SSL On</p>
                                        <button type="submit" asp-page-handler="UseDefault" class="btn btn-primary w-100 mt-3"
                                                onclick="return confirm('Are you sure you want to load the Production profile? Any unsaved changes will be overwritten.');">
                                            Load Profile
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100 border-warning shadow-sm bg-light">
                                    <div class="card-body text-center p-4">
                                        <div class="display-4 text-warning mb-3"><i class="bi bi-cpu-fill"></i></div>
                                        <h4 class="text-uppercase fw-bold text-dark">Debug Mode</h4>
                                        <p class="text-muted small">PaperCut Localhost<br>Port 25 | SSL Off</p>
                                        <button type="submit" asp-page-handler="UsePaperCut" class="btn btn-outline-dark w-100 mt-3" 
                                                onclick="return confirm('Are you sure you want to load the Debug profile? Any unsaved changes will be overwritten.');">
                                            Load Profile
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Footer Actions -->
             <div class="card-footer bg-light d-flex justify-content-end gap-2 p-3 border-top">
                <button type="submit" asp-page-handler="TestConnection" class="btn btn-secondary">
                    <i class="bi bi-wifi me-2"></i> Test Link
                </button>
                <button type="submit" asp-page-handler="Save" class="btn btn-primary">
                    <i class="bi bi-save2-fill me-2"></i> Apply Changes
                </button>
            </div>
        </div>
    </form>
</div>



