@page
@using BulkMailSender.Models
@using System.Text.Json
@model BulkMailSender.Pages.TemplateModel
@{
    ViewData["Title"] = "Draft Email";
}

<style>
    .template-preview { white-space: pre-wrap; border: 1px solid #dee2e6; border-radius: .5rem; padding: 1rem; background: #fff; font-family: 'Courier New', Courier, monospace; font-size: 0.9rem; }
    .sticky-reminder { position: sticky; top: 0; z-index: 1020; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
</style>

<div class="row">
<div class="col-md-12">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-envelope"></i> Configure Email Type</h2>
        <a asp-page="/Upload" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to Upload
        </a>
    </div>

    @if (!Model.HasUploadData)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> No attachment upload found. Please <a asp-page="/Upload">upload attachments</a> and recipients first.
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post">
        <div class="row">
            <!-- Left Column: Settings and Selection -->
            <div class="col-md-5">
                <!-- Main Configuration Card -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Step 1: Settings</h5>
                    </div>
                    <div class="card-body">
                         <div class="alert alert-warning sticky-reminder mb-3 border-warning small p-2">
                             <small><i class="bi bi-bell"></i> <strong>Reminder:</strong> Verify <strong>Period</strong> matches attachments.</small>
                         </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email Type</label>
                            <select class="form-select @(ModelState.GetFieldValidationState(nameof(Model.TemplateType)) == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid ? "is-invalid" : "")" asp-for="TemplateType">
                                <option value="">-- Select Email Type --</option>
                                <option value="SoaInv">SOA &amp; Invoice</option>
                                <option value="Overdue">Overdue</option>
                            </select>
                            <span class="invalid-feedback d-block">@Html.ValidationMessage(nameof(Model.TemplateType))</span>
                            <button type="submit" asp-page-handler="FetchTemplate" class="btn btn-outline-primary btn-sm mt-2" id="btnEditMaster" style="display: none;">
                                <i class="bi bi-pencil-square"></i> Edit Master Template
                            </button>
                        </div>
                        
                        <div class="mb-3" id="periodContainer">
                            <label class="form-label fw-bold">Period (e.g., OCT 2025)</label>
                            <input class="form-control @(ModelState.GetFieldValidationState(nameof(Model.Period)) == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid ? "is-invalid" : "")" asp-for="Period" placeholder="Enter period here"/>
                            <span class="invalid-feedback d-block">@Html.ValidationMessage(nameof(Model.Period))</span>
                        </div>
                    </div>
                </div>

                <!-- Preview Selection -->
                <div class="card mb-4 border-secondary" id="previewSelectSection">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-eye"></i> Step 2: Select Preview</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Select Test Debtor</label>
                            <select class="form-select @(string.IsNullOrEmpty(Model.SubjectPreview) ? "" : "border-success")" asp-for="DebtorCode" id="debtorCodeSelect">
                                <option value="">-- Select a debtor to preview --</option>
                                @foreach (var d in Model.AvailableDebtorCodes)
                                {
                                    <option value="@d.DebtorCode">@d.DebtorCode (@d.EmailCount email(s))</option>
                                }
                            </select>
                        </div>
                        <button type="submit" asp-page-handler="Preview" class="btn btn-outline-primary w-100 mb-3">
                            <i class="bi bi-arrow-repeat"></i> Update Preview
                        </button>
                    </div>
                </div>

                <!-- Actions -->
                 <div class="card shadow mb-4">
                     <div class="card-body">
                        <div class="d-grid gap-2">
                             <button type="submit" asp-page-handler="Save" class="btn btn-outline-secondary">
                                 <i class="bi bi-save"></i> Save Draft
                            </button>
                            <button type="submit" asp-page-handler="Proceed" class="btn btn-primary btn-lg fw-bold shadow">
                                Proceed to Review <i class="bi bi-arrow-right-circle ms-2"></i>
                            </button>
                        </div>
                     </div>
                 </div>
            </div>

            <!-- Right Column: Preview Output -->
            <div class="col-md-7">
                @if (!string.IsNullOrWhiteSpace(Model.SubjectPreview))
                {
                    <div class="card border-success shadow-sm sticky-top" style="top: 1rem; z-index: 1000;">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-check2-circle"></i> Live Preview</h5>
                        </div>
                        <div class="card-body bg-light">
                             @if (!string.IsNullOrWhiteSpace(Model.SelectedOrganizationName))
                            {
                                <div class="alert alert-light border mb-3 py-2">
                                     <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Recipient Context</small>
                                    <div class="row">
                                        <div class="col-md-6"><strong>Debtor:</strong> @Model.DebtorCode</div>
                                        <div class="col-md-6"><strong>Org:</strong> @Model.SelectedOrganizationName</div>
                                    </div>
                                </div>
                            }

                            <label class="form-label text-muted fw-bold small text-uppercase">Subject Line</label>
                            <div class="template-preview mb-3 border-success">@Model.SubjectPreview</div>
                            
                            <label class="form-label text-muted fw-bold small text-uppercase">Email Body</label>
                            <div class="template-preview border-success" style="max-height: 600px; overflow-y: auto;">@Model.BodyPreview</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card bg-light border-light text-center py-5">
                        <div class="card-body text-muted">
                            <i class="bi bi-arrow-left-circle display-4 mb-3 d-block"></i>
                            <h5>No Preview Generated</h5>
                            <p>Configure settings and select a debtor on the left to see the email preview here.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </form>

    <!-- Reference Section (Accordion) -->
     <div class="accordion mt-4 mb-5" id="templateRefAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingRef">
                <button class="accordion-button collapsed text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRef" aria-expanded="false" aria-controls="collapseRef">
                    <i class="bi bi-journal-text me-2"></i> View Default Template Reference
                </button>
            </h2>
            <div id="collapseRef" class="accordion-collapse collapse" aria-labelledby="headingRef" data-bs-parent="#templateRefAccordion">
                <div class="accordion-body bg-light">
                    <h6>SOA &amp; Invoice</h6>
<pre class="small text-muted border p-2 bg-white rounded">Good day to you
The attached statement reflects your account balance.

Please check the statement provided.

If you have any questions regarding this statement or any clarification needs, please contact the ATP Careline 018-7864855

Any overdue payment may lead to service interruption.

