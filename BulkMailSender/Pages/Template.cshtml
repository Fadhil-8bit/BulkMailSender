Direct Line: 018-7864855</pre>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<!-- Customize Template Modal -->
<div class="modal fade" id="customizeModal" tabindex="-1" aria-labelledby="customizeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" id="customizeForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="customizeModalLabel">Edit Master Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Placeholders: 
                        <code>{debtor_code}</code>, <code>{organization_name}</code>, <code>{notes}</code>, <code>{period}</code> (SOA only)
                    </div>
                    
                    <input type="hidden" asp-for="SelectedEditType" id="modalTemplateType" />

                    <div class="mb-3">
                        <label asp-for="EditSubject" class="form-label fw-bold">Subject Line</label>
                        <input asp-for="EditSubject" class="form-control" id="modalSubject" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditBody" class="form-label fw-bold">Email Body</label>
                        <textarea asp-for="EditBody" class="form-control" id="modalBody" rows="10" required></textarea>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="submit" asp-page-handler="ResetTemplate" class="btn btn-danger" onclick="return confirm('Are you sure you want to reset to system defaults? Custom changes will be lost.');">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset to Default
                    </button>
                    <div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" asp-page-handler="SaveMasterTemplate" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Master Template
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var typeSelect = document.getElementById("TemplateType");
            var periodContainer = document.getElementById("periodContainer");
            var periodInput = document.getElementById("Period");
            var previewSelectSection = document.getElementById("previewSelectSection");
            var btnEditMaster = document.getElementById("btnEditMaster");
            
            // Raw templates from server
            var rawTemplates = @Html.Raw(JsonSerializer.Serialize(Model.RawTemplates));
            var showEditModal = @JsonSerializer.Serialize(Model.ShowEditModal).ToLower();
            var hasEditSubject = @JsonSerializer.Serialize(!string.IsNullOrEmpty(Model.EditSubject)).ToLower();

            // Customize Modal Elements
            var customizeModal = new bootstrap.Modal(document.getElementById('customizeModal'));
            var modalTemplateType = document.getElementById("modalTemplateType");
            
            // Automatically show modal if triggered from server
            if (showEditModal || hasEditSubject) {
                customizeModal.show();
            }

            function updateUI() {
                var type = typeSelect ? typeSelect.value : "";
                var period = periodInput ? periodInput.value : "";
                var step1Valid = false;

                // Show/Hide Customize Button
                if (btnEditMaster) {
                    btnEditMaster.style.display = type ? "inline-block" : "none";
                }

                if (type === "SoaInv") {
                    if (periodContainer) {
                        periodContainer.classList.remove("text-muted");
                        periodContainer.style.opacity = "1";
                    }
                    if (periodInput) {
                        periodInput.disabled = false;
                    }
                    if (period && period.trim().length > 0) step1Valid = true;
                } else if (type === "Overdue") {
                    if (periodContainer) {
                        periodContainer.classList.add("text-muted");
                        periodContainer.style.opacity = "0.5";
                    }
                    if (periodInput) {
                        periodInput.disabled = true;
                        periodInput.value = ""; // Clear value since it's not needed
                    }
                    step1Valid = true;
                } else {
                    // No type selected
                    if (periodContainer) {
                         periodContainer.classList.remove("text-muted");
                         periodContainer.style.opacity = "1";
                    }
                    if (periodInput) periodInput.disabled = false;
                    step1Valid = false;
                }

                if (previewSelectSection) {
                    previewSelectSection.style.display = step1Valid ? "block" : "none";
                }
            }

            if (typeSelect) typeSelect.addEventListener("change", updateUI);
            if (periodInput) periodInput.addEventListener("input", updateUI);

            updateUI();
        });
    </script>
}