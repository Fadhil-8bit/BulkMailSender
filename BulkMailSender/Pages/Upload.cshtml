@page
@model BulkMailSender.Pages.UploadModel
@{
    ViewData["Title"] = "Upload Attachments";
}

<style>
    .debtor-scroll-box { 
        max-height: 600px; 
        overflow-y: auto; 
        border: 1px solid #dee2e6; 
        border-radius: .5rem; 
        padding: 1rem; 
        background: #ffffff; 
    }
    .debtor-scroll-box::-webkit-scrollbar { width: 10px; }
    .debtor-scroll-box::-webkit-scrollbar-track { background: #f8f9fa; }
    .debtor-scroll-box::-webkit-scrollbar-thumb { background: #c1c7ce; border-radius: 5px; }
    .debtor-scroll-box::-webkit-scrollbar-thumb:hover { background: #a0a6ac; }
    .accordion-item { background: #fff; }
    .bg-warning-dark { background-color: #ff8c00 !important; color: white !important; }
    .disabled-overlay { position: relative; }
    .disabled-overlay::after { content: ""; position: absolute; inset: 0; background: rgba(255,255,255,0.6); border-radius: .5rem; display: none; }
    .disabled-overlay.disabled::after { display: block; }
</style>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999;">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: white;">
        <div class="spinner-border text-light" role="status" style="width: 5rem; height: 5rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h3 class="mt-4">Uploading and Processing...</h3>
        <p>Please wait. Large files may take several minutes.</p>
        <p id="uploadStatus" class="text-warning">Do not close this window</p>
    </div>
</div>

<div class="row">
<div class="col-md-10 offset-md-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-cloud-upload"></i> Upload Bulk Email Attachments
        </h2>
        <a asp-page="/Recipients" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to Recipients
        </a>
    </div>

        @if (!Model.HasRecipients)
        {
            <div class="alert alert-warning">
                <i class="bi bi-info-circle"></i> Please upload the recipients CSV first. Go to <a asp-page="/Recipients">Recipients</a>.
            </div>
        }

        <div class="accordion mb-4" id="zipHelpAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingZipHelp">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseZipHelp" aria-expanded="false" aria-controls="collapseZipHelp">
                        <i class="bi bi-question-circle me-2"></i> How to prepare the ZIP file?
                    </button>
                </h2>
                <div id="collapseZipHelp" class="accordion-collapse collapse" aria-labelledby="headingZipHelp" data-bs-parent="#zipHelpAccordion">
                    <div class="accordion-body">
                        <p>Files inside the ZIP must follow this naming pattern for automatic categorization:</p>
                        <div class="alert alert-info py-2">
                             <strong>Format:</strong> <code>{DebtorCode} {DocumentType} {CustomCode}.extension</code>
                        </div>
                        <ul class="mb-3">
                            <li><code>DEBT001 INV 12345.pdf</code> - Invoice with custom code</li>
                            <li><code>DEBT001 SOA 98765.pdf</code> - Statement of Account</li>
                            <li><code>DEBT001 OD 456789.pdf</code> - Overdue Notice</li>
                            <li><code>ABC123 OTHER 7890.xlsx</code> - Other documents</li>
                        </ul>
                         <p class="text-muted small mb-0">
                            <strong>Note:</strong> Maximum file size is 500 MB. Large files may take several minutes to process.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="@(Model.HasRecipients ? "" : "disabled-overlay disabled")">
            <form method="post" enctype="multipart/form-data" id="uploadForm">
                <fieldset @(Model.HasRecipients ? "" : "disabled")>
                    <div class="mb-3">
                        <label for="zipFile" class="form-label fw-bold">Select ZIP File</label>
                        <input type="file" 
                               class="form-control form-control-lg @(Model.UploadResult?.Success == false ? "is-invalid" : "")" 
                               id="zipFile" 
                               name="zipFile" 
                               accept=".zip"
                               required>
                        @if (Model.UploadResult?.Success == false)
                        {
                            <div class="invalid-feedback">
                                @Model.UploadResult.Message
                            </div>
                        }
                        <div id="fileSizeInfo" class="form-text mt-2"></div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg" id="uploadBtn">
                            <i class="bi bi-upload"></i> Upload and Extract
                        </button>
                    </div>
                </fieldset>
            </form>
        </div>

        @if (Model.UploadResult != null && Model.UploadResult.Success)
        {
            <div class="alert alert-success mt-4" role="alert">
                <h5 class="alert-heading">
                    <i class="bi bi-check-circle"></i> Success!
                </h5>
                <p>@Model.UploadResult.Message</p>
            </div>

            <div class="card mt-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Extraction Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h3 class="text-primary">@Model.UploadResult.TotalFiles</h3>
                            <p class="text-muted">Total Attachments</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-success">@Model.UploadResult.CategorizedFiles</h3>
                            <p class="text-muted">Debtor Attachment Success</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-danger">@Model.UploadResult.UncategorizedFiles</h3>
                            <p class="text-muted">Debtor Attachment Failed</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-info">@Model.UploadResult.DebtorAttachments.Count</h3>
                            <p class="text-muted">Debtors</p>
                        </div>
                    </div>
                    
                    @if (Model.UploadResult.DebtorAttachments.Any())
                    {
                        <div class="d-flex justify-content-center gap-3 mt-3 border-top pt-3">
                            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reviewModal">
                                <i class="bi bi-list-check"></i> View Extraction Details
                            </button>
                             <a asp-page="/Template" class="btn btn-success px-4 shadow-sm">
                                Next: Draft Email <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>

            @if (Model.UploadResult.Errors.Any())
            {
                <div class="alert alert-danger mt-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="alert-heading mb-1"><i class="bi bi-exclamation-triangle-fill"></i> Uncategorized Files</h5>
                        <p class="mb-0">Found @Model.UploadResult.Errors.Count files that could not be matched. Please review.</p>
                    </div>
                     <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        <i class="bi bi-search"></i> Review Issues
                    </button>
                </div>
            }
        }

<!-- Cards moved to accordion -->
    </div>
</div>

<!-- Modal for Reviewing Extraction Details -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reviewModalLabel"><i class="bi bi-list-check"></i> Review Extraction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
             <div class="modal-body p-0 bg-light">
                @if (Model.UploadResult?.Errors?.Any() == true)
                {
                     <div class="accordion accordion-flush border-bottom" id="errorAccordionModal">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingErrors">
                                <button class="accordion-button bg-danger text-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseErrors" aria-expanded="true" aria-controls="collapseErrors">
                                    <span><i class="bi bi-exclamation-triangle-fill me-2"></i> Failed / Uncategorized Files (@Model.UploadResult.Errors.Count)</span>
                                </button>
                            </h2>
                            <div id="collapseErrors" class="accordion-collapse collapse show" aria-labelledby="headingErrors" data-bs-parent="#errorAccordionModal">
                                <div class="accordion-body bg-danger bg-opacity-10">
                                    <ul class="list-group list-group-flush">
                                        @foreach (var error in Model.UploadResult.Errors)
                                        {
                                            <li class="list-group-item bg-transparent text-danger border-danger border-opacity-25 pb-0 pt-0 border-0">
                                                <small><i class="bi bi-x-circle"></i> @error</small>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.UploadResult?.DebtorAttachments?.Any() == true)
                {
                    <div class="debtor-scroll-box border-0 rounded-0" style="max-height: none;">
                        <div class="accordion" id="debtorAccordionModal">
                             @for (int i = 0; i < Model.UploadResult.DebtorAttachments.Count; i++)
                            {
                                var debtor = Model.UploadResult.DebtorAttachments[i];
                                var accordionId = $"debtorModal{i}";
                                var isExpanded = i == 0 ? "true" : "false";    
                                var buttonClass = i == 0 ? "" : "collapsed";

                                <div class="accordion-item">
                                     <h2 class="accordion-header" id="headingModal@(i)">
                                        <button class="accordion-button @buttonClass" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#@accordionId"
                                                aria-expanded="@isExpanded" aria-controls="@accordionId">
                                            <strong>@debtor.DebtorCode</strong>
                                            <span class="ms-3 badge bg-secondary">@debtor.TotalFileCount files</span>
                                            <span class="ms-2 badge bg-secondary">@debtor.TotalFileSizeFormatted</span>
                                            <span class="ms-2">
                                                @if (debtor.InvoiceFiles.Any()) { <span class="badge bg-success me-1">INV: @debtor.InvoiceFiles.Count</span> }
                                                @if (debtor.StatementFiles.Any()) { <span class="badge bg-primary me-1">SOA: @debtor.StatementFiles.Count</span> }
                                                @if (debtor.OverdueFiles.Any()) { <span class="badge bg-warning-dark me-1">OD: @debtor.OverdueFiles.Count</span> }
                                                @if (debtor.OtherFiles.Any()) { <span class="badge bg-dark">OTHER: @debtor.OtherFiles.Count</span> }
                                            </span>
                                        </button>
                                    </h2>
                                    <div id="@accordionId" class="accordion-collapse collapse" aria-labelledby="headingModal@(i)" data-bs-parent="#debtorAccordionModal">
                                        <div class="accordion-body">
                                             @if (debtor.InvoiceFiles.Any())
                                            {
                                                <h6 class="text-success"><i class="bi bi-file-earmark-text"></i> Invoice Files (@debtor.InvoiceFiles.Count)</h6>
                                                <ul class="list-group mb-3">
                                                    @foreach (var file in debtor.InvoiceFiles)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <span><i class="bi bi-file-pdf text-danger"></i> @file.FileName <small class="text-muted">(Code: @file.CustomCode)</small></span>
                                                            <span class="badge bg-secondary">@file.FileSizeFormatted</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            @if (debtor.StatementFiles.Any())
                                            {
                                                <h6 class="text-primary"><i class="bi bi-file-earmark-spreadsheet"></i> Statement Files (@debtor.StatementFiles.Count)</h6>
                                                <ul class="list-group mb-3">
                                                    @foreach (var file in debtor.StatementFiles)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <span><i class="bi bi-file-pdf text-danger"></i> @file.FileName <small class="text-muted">(Code: @file.CustomCode)</small></span>
                                                            <span class="badge bg-secondary">@file.FileSizeFormatted</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                             @if (debtor.OverdueFiles.Any())
                                            {
                                                <h6 style="color: #ff8c00;"><i class="bi bi-exclamation-triangle"></i> Overdue Files (@debtor.OverdueFiles.Count)</h6>
                                                <ul class="list-group mb-3">
                                                    @foreach (var file in debtor.OverdueFiles)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <span><i class="bi bi-file-pdf text-danger"></i> @file.FileName <small class="text-muted">(Code: @file.CustomCode)</small></span>
                                                            <span class="badge bg-secondary">@file.FileSizeFormatted</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            @if (debtor.OtherFiles.Any())
                                            {
                                                <h6 class="text-dark"><i class="bi bi-files"></i> Other Documents (@debtor.OtherFiles.Count)</h6>
                                                <ul class="list-group mb-3">
                                                    @foreach (var file in debtor.OtherFiles)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <span><i class="bi bi-file-earmark"></i> @file.FileName <small class="text-muted">(Code: @file.CustomCode)</small></span>
                                                            <span class="badge bg-secondary">@file.FileSizeFormatted</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                         <p class="text-muted">No attachments loaded yet.</p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Successful Upload -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel"><i class="bi bi-check-circle-fill"></i> Upload Successful</h5>
            </div>
            <div class="modal-body text-center py-4">
                <h2 class="display-6 text-success mb-3">@Model.UploadResult?.DebtorAttachments.Count Debtors Matched!</h2>
                <p class="lead">Your attachments have been extracted and categorized.</p>
                <p class="text-muted">You can now proceed to draft your email template.</p>
                
                @if (Model.UploadResult?.UncategorizedFiles > 0 || Model.UploadResult?.Errors?.Any() == true)
                {
                    <div class="alert alert-warning d-inline-block mt-3 mb-0 text-start bg-warning bg-opacity-10 border-warning text-dark">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-4 me-3"></i> 
                            <div>
                                <strong>Attention Needed:</strong> 
                                @if (Model.UploadResult?.UncategorizedFiles > 0)
                                {
                                    <span>@Model.UploadResult.UncategorizedFiles file(s) unmatched.</span>
                                }
                                else
                                {
                                    <span>Issues found during upload.</span>
                                }
                                <div class="small text-muted">Please review the extraction details.</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer justify-content-center">
                @if (Model.UploadResult?.UncategorizedFiles > 0 || Model.UploadResult?.Errors?.Any() == true)
                {
                     <button type="button" class="btn btn-danger btn-lg px-4" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        <i class="bi bi-search"></i> Review Issues
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#reviewModal">Review Attachments</button>
                    <a asp-page="/Template" class="btn btn-success btn-lg px-4"><i class="bi bi-arrow-right-circle"></i> Continue to Draft</a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Request.Method == "POST" && Model.UploadResult?.Success == true)
    {
         <script>
            document.addEventListener("DOMContentLoaded", function () {
                var myModal = new bootstrap.Modal(document.getElementById('successModal'));
                myModal.show();
            });
        </script>
    }
    <script>
        const zipFileInput = document.getElementById('zipFile');
        const uploadForm = document.getElementById('uploadForm');
        const uploadBtn = document.getElementById('uploadBtn');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const fileSizeInfo = document.getElementById('fileSizeInfo');
        let isSubmitting = false;

        zipFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) {
                fileSizeInfo.innerHTML = '';
                return;
            }
            
            const fileName = file.name;
            const fileSize = file.size;
            const maxSize = 500 * 1024 * 1024; // 500 MB
            const fileSizeMB = (fileSize / (1024 * 1024)).toFixed(2);
            
            if (!fileName.toLowerCase().endsWith('.zip')) {
                alert('Please select a ZIP file.');
                e.target.value = '';
                fileSizeInfo.innerHTML = '';
                return;
            }
            
            if (fileSize > maxSize) {
                alert(`File size (${fileSizeMB} MB) exceeds maximum allowed size of 500 MB.`);
                e.target.value = '';
                fileSizeInfo.innerHTML = '';
                return;
            }

            // Show file size and estimated upload time
            let estimatedTime = '';
            if (fileSize > 50 * 1024 * 1024) { // > 50MB
                const minutes = Math.ceil((fileSize / (1024 * 1024)) / 10); // Rough estimate: 10 MB/min
                estimatedTime = ` - Estimated upload time: ${minutes} minute${minutes > 1 ? 's' : ''}`;
            }
            
            fileSizeInfo.innerHTML = `<i class="bi bi-info-circle text-info"></i> File size: <strong>${fileSizeMB} MB</strong>${estimatedTime}`;
        });

        uploadForm.addEventListener('submit', function(e) {
            const file = zipFileInput.files[0];
            if (!file) {
                return;
            }

            // If recipients are not available, block submit (extra safety)
            const hasRecipients = "@(Model.HasRecipients.ToString().ToLower())" === "true";
            if (hasRecipients !== true) {
                e.preventDefault();
                alert('Please upload the recipients CSV first.');
                return;
            }

            // Set submitting flag
            isSubmitting = true;

            // Show loading overlay
            loadingOverlay.style.display = 'block';
            uploadBtn.disabled = true;
            uploadBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Uploading... Please wait';

            // Prevent accidental page close
            window.onbeforeunload = function() {
                // If we are submitting, don't show the warning
                if (isSubmitting) return;
                return "Upload in progress. Are you sure you want to leave?";
            };
            
            // Note: In Chrome/Edge, onbeforeunload behaves differently during form submission.
            // If the submission takes a long time, the browser might show a spinner but not trigger 
            // unload until the response headers come back. 
            // The return value is often ignored for modern browsers unless there's user interaction.

            // Update status message periodically
            let dots = 0;
            const statusInterval = setInterval(function() {
                dots = (dots + 1) % 4;
                const dotsStr = '.'.repeat(dots);
                document.getElementById('uploadStatus').textContent = `Processing${dotsStr}`;
            }, 500);

            // Store interval ID to clear it later if needed
            window.uploadStatusInterval = statusInterval;
        });

        // Clear beforeunload on page load (after successful upload)
        window.addEventListener('load', function() {
            window.onbeforeunload = null;
            if (window.uploadStatusInterval) {
                clearInterval(window.uploadStatusInterval);
            }
        });
    </script>
}
