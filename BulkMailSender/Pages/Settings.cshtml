@page
@model BulkMailSender.Pages.SettingsModel
@{
    ViewData["Title"] = "System Configuration";
}

<style>
    /* Game UI Theme Overrides - High Contrast Dark Edition */
    .game-ui-container {
        background-color: #121212; /* Deep Black Background */
        color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 600px;
        border: 1px solid #333;
        overflow: hidden;
    }

    /* Sidebar Navigation */
    .game-sidebar {
        background-color: #050505; /* Almost Pitch Black */
        border-right: 1px solid #333;
        padding: 20px 0;
    }

    .game-nav-item {
        padding: 15px 25px;
        cursor: pointer;
        transition: all 0.2s ease;
        border-left: 4px solid transparent;
        color: #999; /* Medium Grey */
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
    }

    .game-nav-item:hover {
        background-color: #1f1f1f;
        color: #fff;
    }

    .game-nav-item.active {
        background-color: #252525;
        color: #ffffff;
        border-left-color: #f8f9fa; /* White accent */
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
        background: linear-gradient(90deg, #252525, #050505);
    }

    .game-nav-item i {
        margin-right: 12px;
        font-size: 1.1rem;
    }

    /* Content Area */
    .game-content {
        background-color: #121212;
        padding: 30px 40px;
    }

    .game-header {
        border-bottom: 1px solid #333;
        padding-bottom: 15px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .game-header h2 {
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 800;
        font-size: 1.6rem;
        margin: 0;
    }

    /* Form Elements */
    .game-input-group {
        margin-bottom: 25px;
        position: relative;
    }

    .game-label {
        display: block;
        color: #e0e0e0; /* Bright Grey Label */
        font-size: 0.85rem;
        text-transform: uppercase;
        margin-bottom: 8px;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .game-input {
        background-color: #1e1e1e; /* Distinct dark grey inputs */
        border: 1px solid #444;
        color: #fff;
        padding: 14px 18px;
        width: 100%;
        border-radius: 4px;
        transition: border-color 0.3s, box-shadow 0.3s;
        font-family: Consolas, 'Courier New', monospace; /* Tech/Terminal Font */
    }

    .game-input:focus {
        border-color: #fff;
        background-color: #262626;
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
        outline: none;
    }

    .game-helper {
        color: #aaa;
        font-size: 0.8rem;
        margin-top: 6px;
    }

    /* Switches / Checks */
    .game-switch-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #1e1e1e;
        padding: 15px;
        border-radius: 4px;
        border: 1px solid #444;
    }

    /* Action Bar */
    .game-actions {
        position: sticky;
        bottom: 0;
        background-color: #0a0a0a;
        padding: 20px 40px;
        border-top: 1px solid #333;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        z-index: 10;
        margin: 0 -12px -12px -12px;
    }

    .game-btn {
        padding: 10px 30px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        border-radius: 2px;
    }

    .game-btn-primary {
        background: #ffffff;
        color: #000;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
    }

    .game-btn-primary:hover {
        transform: translateY(-2px);
        background: #e0e0e0;
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    }
    
    .game-btn-secondary {
        background: transparent;
        border: 1px solid #666;
        color: #aaa;
    }

    .game-btn-secondary:hover {
        border-color: #fff;
        color: #fff;
        background: rgba(255,255,255,0.05);
    }

    .game-btn-danger {
        background: transparent;
        border: 1px solid #ff4444;
        color: #ff4444;
    }
    
    .game-btn-danger:hover {
        background: rgba(255, 68, 68, 0.1);
        box-shadow: 0 0 15px rgba(255, 68, 68, 0.2);
    }

    /* Presets Cards */
    .preset-card {
        background: #1e1e1e;
        border: 1px solid #444;
        padding: 20px;
        border-radius: 4px;
        height: 100%;
        transition: all 0.3s;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .preset-card:hover {
        border-color: #fff;
        transform: translateY(-5px);
        background-color: #252525;
    }

    .preset-card.active-preset {
        border-color: #fff;
        background: #252525;
    }

    .preset-icon {
        font-size: 2rem;
        margin-bottom: 15px;
        color: #fff;
    }

    /* Layout Utilities */
    .tab-content {
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>



<div class="container-fluid py-4">
    
    <!-- Status Messages overlaid or top -->
    @if (Model.HasSavedSettings)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 shadow-lg mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> settings_saved_successfully
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.TestResult))
    {
        <div class="alert @(Model.TestSuccess ? "alert-success bg-success" : "alert-danger bg-danger") text-white border-0 shadow-lg mb-4 alert-dismissible fade show" role="alert">
            <i class="bi @(Model.TestSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i> @Model.TestResult
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post" id="settingsForm">
        <div class="game-ui-container row g-0">
            <!-- Sidebar -->
            <div class="col-md-3 game-sidebar d-flex flex-column justify-content-between">
                <div>
                    <div class="px-4 py-3 mb-4 text-center border-bottom border-secondary">
                        <i class="bi bi-sliders2 fs-1 text-secondary"></i>
                        <div class="mt-2 fw-bold text-uppercase small text-muted">CONFIG PANEL v1.0</div>
                    </div>
                    
                    <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="game-nav-item nav-link active" id="v-pills-general-tab" data-bs-toggle="pill" data-bs-target="#v-pills-general" type="button" role="tab" aria-selected="true">
                            <i class="bi bi-person-badge"></i> EXOP General
                        </button>
                        <button class="game-nav-item nav-link" id="v-pills-connection-tab" data-bs-toggle="pill" data-bs-target="#v-pills-connection" type="button" role="tab" aria-selected="false">
                            <i class="bi bi-hdd-network"></i> Network
                        </button>
                        <button class="game-nav-item nav-link" id="v-pills-advanced-tab" data-bs-toggle="pill" data-bs-target="#v-pills-advanced" type="button" role="tab" aria-selected="false">
                            <i class="bi bi-sliders"></i> Advanced
                        </button>
                        <button class="game-nav-item nav-link" id="v-pills-presets-tab" data-bs-toggle="pill" data-bs-target="#v-pills-presets" type="button" role="tab" aria-selected="false">
                            <i class="bi bi-stars"></i> Presets
                        </button>
                    </div>
                </div>
                
                <div class="p-4 text-muted small text-center opacity-50">
                    <i class="bi bi-shield-lock-fill"></i> SECURE // ENCRYPTED
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9 d-flex flex-column">
                <div class="game-content flex-grow-1">
                    <div class="tab-content" id="v-pills-tabContent">
                        
                        <!-- TAB: GENERAL -->
                        <div class="tab-pane fade show active" id="v-pills-general" role="tabpanel">
                            <div class="game-header">
                                <h2>Identity Configuration</h2>
                                <span class="badge bg-secondary">Required</span>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="game-input-group">
                                        <label class="game-label">From Email Address</label>
                                        <input type="email" class="game-input" asp-for="CurrentSettings.FromEmail" placeholder="ops@domain.com" />
                                        <div class="game-helper">The origin address shown to recipients.</div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="game-input-group">
                                        <label class="game-label">Display Name</label>
                                        <input type="text" class="game-input" asp-for="CurrentSettings.FromName" placeholder="System Administrator" />
                                        <div class="game-helper">The friendly name displayed in mail clients.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB: CONNECTION -->
                        <div class="tab-pane fade" id="v-pills-connection" role="tabpanel">
                            <div class="game-header">
                                <h2>Server Connection</h2>
                                <span class="badge bg-info text-dark">SMTP</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-8">
                                    <div class="game-input-group">
                                        <label class="game-label">Host Address</label>
                                        <input type="text" class="game-input" asp-for="CurrentSettings.Host" placeholder="smtp.provider.net" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="game-input-group">
                                        <label class="game-label">Port</label>
                                        <input type="number" class="game-input" asp-for="CurrentSettings.Port" placeholder="587" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="game-input-group">
                                        <label class="game-label">Username</label>
                                        <input type="text" class="game-input" asp-for="CurrentSettings.Username" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="game-input-group">
                                        <label class="game-label">Password / Key</label>
                                        <input type="password" class="game-input" asp-for="CurrentSettings.Password" autocomplete="off" value="@Model.CurrentSettings.Password" />
                                    </div>
                                </div>

                                <div class="col-12 mt-3">
                                    <div class="game-switch-container">
                                        <div>
                                            <div class="fw-bold text-white mb-1">Enable SSL/TLS Encryption</div>
                                            <div class="small text-muted">Secure connection layer for data protection</div>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="CurrentSettings.EnableSsl" style="transform: scale(1.5);">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB: ADVANCED -->
                        <div class="tab-pane fade" id="v-pills-advanced" role="tabpanel">
                            <div class="game-header">
                                <h2>Advanced Parameters</h2>
                                <span class="badge bg-warning text-dark">Optional</span>
                            </div>

                            <div class="game-input-group">
                                <label class="game-label">Global CC (Surveillance)</label>
                                <textarea class="game-input" asp-for="CurrentSettings.GlobalCc" rows="2" placeholder="audit@corp.com; boss@corp.com"></textarea>
                                <div class="game-helper">Semicolon-separated list. Copies all traffic to these addresses.</div>
                            </div>

                            <div class="game-input-group w-50">
                                <label class="game-label">Connection Timeout (Seconds)</label>
                                <input type="number" class="game-input" asp-for="CurrentSettings.TimeoutSeconds" />
                            </div>
                            
                            @if (Model.HasSavedSettings)
                            {
                                <div class="mt-5 pt-4 border-top border-secondary">
                                    <h5 class="text-danger text-uppercase mb-3">Danger Zone</h5>
                                    <button type="submit" asp-page-handler="ClearSettings" class="game-btn game-btn-danger"
                                            onclick="return confirm('WARNING: This will purge all configuration data. Continue?');">
                                        <i class="bi bi-trash me-2"></i> Factory Reset
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- TAB: PRESETS -->
                        <div class="tab-pane fade" id="v-pills-presets" role="tabpanel">
                            <div class="game-header">
                                <h2>Quick Load Profiles</h2>
                            </div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="preset-card">
                                        <div class="preset-icon"><i class="bi bi-cloud-lightning-fill"></i></div>
                                        <h4 class="text-white text-uppercase">Production</h4>
                                        <p class="text-muted small">Brevo Relay Configuration<br>Port 587 | SSL On</p>
                                        <button type="submit" asp-page-handler="UseDefault" class="game-btn game-btn-primary w-100 mt-3">
                                            Load Profile
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="preset-card" style="border-color: #ffaa00;">
                                        <div class="preset-icon" style="color: #ffaa00;"><i class="bi bi-cpu-fill"></i></div>
                                        <h4 class="text-white text-uppercase">Debug Mode</h4>
                                        <p class="text-muted small">PaperCut Localhost<br>Port 25 | SSL Off</p>
                                        <button type="submit" asp-page-handler="UsePaperCut" class="game-btn game-btn-secondary w-100 mt-3" style="border-color: #ffaa00; color: #ffaa00;">
                                            Load Profile
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="game-actions">
                    <button type="submit" asp-page-handler="TestConnection" class="game-btn game-btn-secondary">
                        <i class="bi bi-wifi me-2"></i> Test Link
                    </button>
                    <button type="submit" asp-page-handler="Save" class="game-btn game-btn-primary">
                        <i class="bi bi-save2-fill me-2"></i> Apply Changes
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

