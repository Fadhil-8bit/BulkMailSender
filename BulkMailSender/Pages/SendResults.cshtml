@page
@model BulkMailSender.Pages.SendResultsModel
@{
    ViewData["Title"] = "Send Results";
}

<style>
    .result-row-success { background-color: #d1e7dd; }
    .result-row-failed { background-color: #f8d7da; }
    .result-row-skipped { background-color: #fff3cd; }
    .result-table { font-size: 0.9rem; }
    .badge-retry { font-size: 0.75rem; }
</style>

<div class="row">
    <div class="col-md-11 offset-md-0">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-check2-circle"></i> Send Results</h2>
            <a asp-page="/Preview" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Review
            </a>
        </div>

        @if (Model.Results == null)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i> No send results found. Please complete the send process first.
            </div>
            <div class="text-center mt-4">
                <a asp-page="/Upload" class="btn btn-primary">Start New Upload</a>
            </div>
        }
        else
        {
            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h3 class="text-success mb-0">
                                <span id="sent-count">@Model.Results.Sent.Count</span>
                                <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" id="sent-spinner"></span>
                            </h3>
                            <p class="text-muted mb-0"><i class="bi bi-check-circle"></i> Sent Successfully</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <h3 class="text-danger mb-0">
                                <span id="failed-count">@Model.Results.Failed.Count</span>
                                <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" id="failed-spinner"></span>
                            </h3>
                            <p class="text-muted mb-0"><i class="bi bi-x-circle"></i> Failed</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <h3 class="text-warning mb-0">@Model.Results.Skipped.Count</h3>
                            <p class="text-muted mb-0"><i class="bi bi-skip-forward-circle"></i> Skipped</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <h3 class="text-info mb-0">
                                <span id="total-count">@(Model.Results.Sent.Count + Model.Results.Failed.Count + Model.Results.Skipped.Count)</span>
                                <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" id="total-spinner"></span>
                            </h3>
                            <p class="text-muted mb-0"><i class="bi bi-envelope"></i> Total Processed</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            @if (Model.Results.Failed.Any())
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>@Model.Results.Failed.Count failed email(s)</strong> - Review the errors below and retry if needed.
                    </div>
                    <div>
                        <form method="post" asp-page-handler="DownloadFailed" style="display:inline;" class="me-2">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-download"></i> Download Failed CSV
                            </button>
                        </form>
                        <form method="post" asp-page-handler="RetryFailed" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="bi bi-arrow-clockwise"></i> Retry Failed Emails
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Detailed Results Table -->
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-list-check"></i> Detailed Results</h5>
                    <small>@(Model.Results.Sent.Count + Model.Results.Failed.Count + Model.Results.Skipped.Count) total</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover result-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 15%;">Debtor Code</th>
                                    <th style="width: 10%;">Status</th>
                                    <th style="width: 30%;">Recipients (TO)</th>
                                    <th style="width: 25%;">Message / Error</th>
                                    <th style="width: 10%;">Timestamp</th>
                                    <th style="width: 5%;">Retries</th>
                                </tr>
                            </thead>
                            <tbody id="results-table-body">
                                <partial name="_SendResultsTableRows" model="Model.Results" />
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Action Footer -->
            <div class="card mt-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="mb-3"><i class="bi bi-info-circle"></i> What's Next?</h6>
                            <ul class="mb-0">
                                <li>Review the detailed results above</li>
                                @if (Model.Results.Failed.Any())
                                {
                                    <li>Download failed emails CSV for manual review</li>
                                    <li>Fix any issues and retry failed emails</li>
                                }
                                else
                                {
                                    <li class="text-success">All emails sent successfully! ?</li>
                                }
                                <li>Start a new upload session when ready</li>
                            </ul>
                        </div>
                        <div class="col-md-6 text-end">
                            <a asp-page="/Upload" class="btn btn-primary btn-lg">
                                <i class="bi bi-plus-circle"></i> Start New Upload
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let isFirstCheck = true;
            let pollInterval;
            let lastSent = -1;
            let lastFailed = -1;

            function updateTable() {
                 fetch('?handler=ResultsPartial')
                    .then(response => response.text())
                    .then(html => {
                        const tbody = document.getElementById('results-table-body');
                        if (tbody) tbody.innerHTML = html;
                    })
                    .catch(error => console.error('Error fetching table partial:', error));
            }

            function updateStatus() {
                fetch('?handler=JobStatus')
                    .then(response => response.json())
                    .then(data => {
                        const sentCount = document.getElementById("sent-count");
                        const failedCount = document.getElementById("failed-count");
                        const totalCount = document.getElementById("total-count");

                        // Check for changes before updating DOM
                        const newSent = data.sentCount;
                        const newFailed = data.failedCount;

                        if (lastSent !== -1 && (newSent !== lastSent || newFailed !== lastFailed)) {
                            updateTable();
                        }
                        
                        lastSent = newSent;
                        lastFailed = newFailed;

                        if (sentCount) sentCount.innerText = data.sentCount;
                        if (failedCount) failedCount.innerText = data.failedCount;
                        if (totalCount) totalCount.innerText = data.total;

                        if (data.isCompleted) {
                            if (pollInterval) clearInterval(pollInterval);
                            updateTable(); // Final update
                        }
                        
                        if (isFirstCheck) {
                            const ids = ['sent-spinner', 'failed-spinner', 'total-spinner'];
                            ids.forEach(id => {
                                const el = document.getElementById(id);
                                if (el) el.style.display = 'none';
                            });
                             updateTable(); // Initial load
                        }
                        
                        isFirstCheck = false;
                    })
                    .catch(error => console.error('Error fetching status:', error));
            }

            // Update every 3 seconds
            pollInterval = setInterval(updateStatus, 3000);
            
            // Initial call
            updateStatus();
        });
    </script>
}
